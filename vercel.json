{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/room.js": {
      "maxDuration": 10
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/speedster",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/speedster/play",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/play",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/:path*",
      "destination": "https://manta-ray-dioscurias.vercel.app/projects/:path*",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "https://manta-ray-dioscurias.vercel.app/about",
      "permanent": false
    }
  ]
}
