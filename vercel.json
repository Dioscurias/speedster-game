{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/room.js": {
      "maxDuration": 10
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/play",
      "destination": "/projects/speedster/play",
      "permanent": false
    }
  ]
}
