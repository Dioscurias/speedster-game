{
  "name": "speedster-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/game-browser-check.mjs",
    "test:rooms": "node scripts/room-check.mjs",
    "dev:rooms": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "deploy:rooms": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.7",
    "wrangler": "^4.152.0"
  }
}
